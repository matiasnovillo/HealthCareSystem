@HealthCareSystem.AppointmentsAPI_HostAddress = http://localhost:5186
@appointmentId = 25d45048-8ffd-4cb4-b023-99a2d02c5923

### Retrieve all appointments
GET {{HealthCareSystem.AppointmentsAPI_HostAddress}}/api/Appointment/GetAll
Accept: application/json

### Retrieve one appointment by ID
GET {{HealthCareSystem.AppointmentsAPI_HostAddress}}/api/Appointment/GetOneByGUID/{{appointmentId}}
Accept: application/json

### Retrieve one appointment with details
GET {{HealthCareSystem.AppointmentsAPI_HostAddress}}/api/Appointment/GetOneByGUID/{{appointmentId}}/Details
Accept: application/json

### Create a new appointment
POST {{HealthCareSystem.AppointmentsAPI_HostAddress}}/api/Appointment/Post
Content-Type: application/json

{
  "patientId": "d76d0ef5-7fe7-42a6-99cf-5df297968d9b",
  "doctorId": "7caefab0-c20c-4569-bd4a-5f1a17f28412",
  "startTime": "2026-12-15T18:00:00",
  "endTime": "2026-12-15T19:00:00",
  "roomNumber": "120",
  "building": "Sarmiento",
  "purpose": "Consulta sobre dolor de estomago"
}

### Update an appointment
PUT {{HealthCareSystem.AppointmentsAPI_HostAddress}}/api/Appointment/Put/{{appointmentId}}
Content-Type: application/json
{
  "appointmentId": "{{appointmentId}}",
  "patientId": "d76d0ef5-7fe7-42a6-99cf-5df297968d9b",
  "doctorId": "7caefab0-c20c-4569-bd4a-5f1a17f28412",
  "startTime": "2026-12-15T10:30:00",
  "endTime": "2026-12-15T11:30:00",
  "roomNumber": "201",
  "building": "Second Building",
  "purpose": "Follow-up Consultation"
}

### Delete an appointment
DELETE {{HealthCareSystem.AppointmentsAPI_HostAddress}}/api/Appointment/Delete/{{appointmentId}}